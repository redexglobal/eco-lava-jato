# Eco Lava Jato — variáveis de ambiente.
# Copie para .env.local e preencha. NUNCA commite o .env.local (já está no .gitignore).
# Hoje o app roda em modo demonstração e NÃO precisa de nenhuma variável.
# As abaixo só serão usadas quando o Supabase for conectado.

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon/publishable) — protegida pelas políticas RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor/Vercel, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
